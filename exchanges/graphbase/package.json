{
  "name": "exchange-graphbase",
  "version": "9.0.0",
  "description": "A normalized and configurable cache exchange for urql",
  "sideEffects": false,
  "license": "MIT",
  "author": "alcala.rao@gmail.com (Roy Alcala)",
  "repository": {
    "type": "git",
    "url": "https://github.com/urql-graphql/urql.git",
    "directory": "exchanges/graphbase"
  },
  "keywords": [
    "urql",
    "state management",
    "normalized cache",
    "cache",
    "formidablelabs",
    "exchanges"
  ],
  "main": "dist/exchange-graphbase",
  "module": "dist/exchange-graphbase.mjs",
  "types": "dist/exchange-graphbase.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/exchange-graphbase.d.ts",
      "import": "./dist/exchange-graphbase.mjs",
      "require": "./dist/exchange-graphbase.js",
      "source": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./extras": {
      "types": "./dist/exchange-graphbase-extras.d.ts",
      "import": "./dist/exchange-graphbase-extras.mjs",
      "require": "./dist/exchange-graphbase-extras.js",
      "source": "./src/extras/index.ts"
    },
    "./default-storage": {
      "types": "./dist/exchange-graphbase-default-storage.d.ts",
      "import": "./dist/exchange-graphbase-default-storage.mjs",
      "require": "./dist/exchange-graphbase-default-storage.js",
      "source": "./src/default-storage/index.ts"
    }
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "dist/",
    "extras/",
    "default-storage/"
  ],
  "scripts": {
    "test": "vitest",
    "clean": "rimraf dist extras",
    "check": "tsc --noEmit",
    "lint": "eslint --ext=js,jsx,ts,tsx .",
    "build": "rollup -c ../../scripts/rollup/config.mjs",
    "prepare": "node ../../scripts/prepare/index.js",
    "prepublishOnly": "run-s clean build"
  },
  "peerDependencies": {
    "@urql/core": "^6.0.0"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.0.13",
    "@urql/core": "workspace:^6.0.1",
    "tinybase": "^7.3.0",
    "wonka": "^6.3.2"
  },
  "devDependencies": {
    "@cypress/react": "^8.0.2",
    "@urql/core": "workspace:*",
    "@urql/exchange-execute": "workspace:*",
    "@urql/introspection": "workspace:*",
    "cypress": "^13.14.0",
    "graphql": "^16.6.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "urql": "workspace:*"
  },
  "publishConfig": {
    "provenance": true
  }
}
